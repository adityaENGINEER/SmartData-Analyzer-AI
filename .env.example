# DataDoctor AI Configuration Template
# Copy this file to .env and configure your keys if using optional external LLM services.
# Core profiling, data cleaning, statistical anomaly detection, and SQL run 100% locally with NO API key needed.

# Optional: OpenAI API Key (for LLM Natural Language Analytics)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: Groq / Ollama / OpenAI-compatible endpoint
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_MODEL=llama3
